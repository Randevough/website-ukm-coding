---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/components/components.css";
import "../styles/components/pages.css";
import "../styles/components/home.css";
import "../styles/components/hero-effects.css";

import SkipLink from "../components/global/SkipLink.astro";
import Rails from "../components/global/Rails.astro";
import Header from "../components/global/Header.astro";
import Drawer from "../components/global/Drawer.astro";
import Footer from "../components/global/Footer.astro";
import Modal from "../components/global/Modal.astro";
import SEO from "../components/global/SEO.astro";
import GoogleAnalytics from "../components/global/GoogleAnalytics.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: "website" | "article";
  showRails?: boolean;
  articleData?: {
    headline: string;
    datePublished: string;
    authorName: string;
  };
  eventData?: {
    name: string;
    startDate: string;
    endDate?: string;
    location?: string;
  };
  breadcrumb?: Array<{ name: string; item: string }>;
}
const {
  title,
  description,
  image,
  canonical,
  noindex,
  type,
  showRails = true,
  articleData,
  eventData,
  breadcrumb,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      noindex={noindex || import.meta.env.PUBLIC_NOINDEX === "true"}
      articleData={articleData}
      eventData={eventData}
      breadcrumb={breadcrumb}
    />
    <GoogleAnalytics />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon-dark.ico"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
      media="(prefers-color-scheme: light)"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/web-app-manifest-192x192.png"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="UKM Coding" />
    <link
      rel="preload"
      href="/fonts/PlusJakartaSans.v2.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/InstrumentSerif.v2.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body data-mark="blue" data-page="home">
    <div id="nav-progress" class="nav-progress" aria-hidden="true"></div>
    <SkipLink />
    {showRails && <Rails />}
    <Header />
    <Drawer />

    <main id="page" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <Modal />

    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/hero-effects.ts"></script>
  </body>
</html>
