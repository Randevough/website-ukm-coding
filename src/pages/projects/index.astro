---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { UKM_FIXTURE } from "../../lib/content/fixture";
import { fetchSanity } from "../../lib/sanity/client";
import { siteSettingsQuery, allProjectsQuery } from "../../lib/sanity/queries";

let settings = UKM_FIXTURE.settings;
let projects = UKM_FIXTURE.projects;

const [sanitySettings, sanityProjects] = await Promise.all([
  fetchSanity<any>(siteSettingsQuery),
  fetchSanity<any[]>(allProjectsQuery),
]);

if (sanitySettings) {
  settings = { ...settings, ...sanitySettings };
}

if (sanityProjects && sanityProjects.length > 0) {
  projects = sanityProjects;
}

const breadcrumb = [
  { name: "Beranda", item: new URL("/", Astro.site || Astro.url.origin).href },
  {
    name: "Projects",
    item: new URL("/projects", Astro.site || Astro.url.origin).href,
  },
];
---

<Layout
  title={`Projects | ${settings.nama}`}
  description="Karya inovatif mahasiswa Cyber University yang berawal dari hobi dan eksperimen teknologi."
  breadcrumb={breadcrumb}
  showRails={false}
>
  <!-- ================= KEPALA HALAMAN ================= -->
  <section
    class="pagehead"
    data-mark="orange"
    style="padding-top: clamp(var(--s5), 5vw, var(--s8)); padding-bottom: clamp(var(--s5), 4vw, var(--s7));"
  >
    <div class="pagehead__paper-wash" aria-hidden="true"></div>
    <div class="grid-fx" aria-hidden="true">
      <div class="grid-fx__spot grid-fx__spot--a">
        <div class="grid-fx__pattern"></div>
      </div>
      <div class="grid-fx__spot grid-fx__spot--b">
        <div class="grid-fx__pattern"></div>
      </div>
    </div>
    <div class="container pagehead__inner">
      <div class="breadcrumb">
        <a href="/">Beranda</a><span>/</span><span>Projects</span>
      </div>
      <h1 class="pagehead__title">
        <span class="lineMask"><span>Project showcase</span></span>
        <span class="lineMask"
          ><span class="thin" style="color: var(--orange);"
            >karya kami</span
          ></span
        >
      </h1>
      <div class="pagehead__foot">
        <p class="lead" data-reveal style="--reveal-delay: 360ms">
          Kami terbiasa belajar dengan mengerjakan project secara langsung,
          sendiri maupun bersama tim. Halaman ini berisi hasil kerja anggota UKM
          Coding selama menjalani proses tersebut.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= KISI ================= -->
  <section
    class="section section--hairline"
    style="padding-top: var(--s6); padding-bottom: var(--s6);"
  >
    <div class="container">
      <div class="filterbar">
        <div class="filterbar__group filterbar__group--left">
          <div class="chips hide-sm" id="projectChips" data-chips>
            <button class="chip is-active" type="button" disabled>Semua</button>
            <button class="chip" type="button" disabled>Web App</button>
            <button class="chip" type="button" disabled>Mobile</button>
            <button class="chip" type="button" disabled>IoT / Hardware</button>
            <button class="chip" type="button" disabled>Lainnya</button>
          </div>

          <div
            class="cselect only-sm"
            id="mobileCatDropdown"
            tabindex="0"
            role="combobox"
            aria-expanded="false"
          >
            <span class="cselect__value" id="mobileCatDropdownValue">Semua</span
            >
            <svg
              class="cselect__arrow"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
            <ul class="cselect__list" role="listbox">
              <li
                class="cselect__opt is-selected"
                role="option"
                aria-selected="true"
                data-value="Semua"
              >
                Semua
              </li>
              <li
                class="cselect__opt"
                role="option"
                aria-selected="false"
                data-value="Web App"
              >
                Web App
              </li>
              <li
                class="cselect__opt"
                role="option"
                aria-selected="false"
                data-value="Mobile"
              >
                Mobile
              </li>
              <li
                class="cselect__opt"
                role="option"
                aria-selected="false"
                data-value="IoT / Hardware"
              >
                IoT / Hardware
              </li>
              <li
                class="cselect__opt"
                role="option"
                aria-selected="false"
                data-value="Lainnya"
              >
                Lainnya
              </li>
            </ul>
          </div>

          <div
            class="cselect"
            id="timeframeDropdown"
            role="combobox"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Filter Waktu"
            tabindex="0"
          >
            <span class="cselect__value" id="timeframeValue">Semua Waktu</span>
            <svg
              class="cselect__arrow"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
            <ul class="cselect__list" role="listbox" aria-label="Filter Waktu">
              <li
                class="cselect__opt is-selected"
                role="option"
                aria-selected="true"
                data-value="Semua Waktu"
              >
                Semua Waktu
              </li>
              <li
                class="cselect__opt"
                role="option"
                aria-selected="false"
                data-value="Tahun 2026"
              >
                Tahun 2026
              </li>
              <li
                class="cselect__opt"
                role="option"
                aria-selected="false"
                data-value="Tahun 2025"
              >
                Tahun 2025
              </li>
              <li
                class="cselect__opt"
                role="option"
                aria-selected="false"
                data-value="Tahun 2024"
              >
                Tahun 2024
              </li>
            </ul>
          </div>
        </div>

        <div class="filterbar__group filterbar__group--right">
          <input
            class="search search--full-sm"
            type="search"
            placeholder="Cari project…"
            aria-label="Cari project"
            disabled
          />
        </div>
      </div>

      <div
        class="bento"
        id="projectGrid"
        style="margin-top: var(--s5)"
        data-stagger="70"
        data-cursor="Lihat cepat"
      >
        {
          projects.map((p) => {
            return <ProjectCard project={p} />;
          })
        }
      </div>

      <div class="pagination" data-pagination>
        <!-- Injected via JS -->
      </div>
    </div>
  </section>

  <template id="all-projects-template">
    {
      projects.map((p: any) => (
        <div
          data-project-item
          data-kategori={p.kategori}
          data-title={(p.nama || p.title || "").toLowerCase()}
          data-date={p.tahun || p.tanggal || ""}
        >
          <ProjectCard project={p} />
        </div>
      ))
    }
  </template>

  <template id="empty-state-template">
    <EmptyState />
  </template>

  <template id="skeleton-projects-template">
    <div class="pcard skeleton-card" style="pointer-events:none;">
      <div class="skeleton skeleton-img"></div>
      <div class="pcard__body" style="padding: 0;">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text long"></div>
        <div class="skeleton skeleton-text medium"></div>
      </div>
    </div>
  </template>

  <script src="../../scripts/filter.ts"></script>
</Layout>
