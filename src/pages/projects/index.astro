---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { UKM_FIXTURE } from "../../lib/content/fixture";
import { fetchSanity } from "../../lib/sanity/client";
import { siteSettingsQuery, allProjectsQuery } from "../../lib/sanity/queries";

let settings = UKM_FIXTURE.settings;
let projects = UKM_FIXTURE.projects;

const [sanitySettings, sanityProjects] = await Promise.all([
  fetchSanity<any>(siteSettingsQuery),
  fetchSanity<any[]>(allProjectsQuery),
]);

if (sanitySettings) {
  settings = { ...settings, ...sanitySettings };
}

if (sanityProjects && sanityProjects.length > 0) {
  projects = sanityProjects;
}

const breadcrumb = [
  { name: "Beranda", item: new URL("/", Astro.site || Astro.url.origin).href },
  {
    name: "Projects",
    item: new URL("/projects", Astro.site || Astro.url.origin).href,
  },
];
---

<Layout
  title={`Projects | ${settings.nama}`}
  description="Karya inovatif mahasiswa Cyber University yang berawal dari hobi dan eksperimen teknologi."
  breadcrumb={breadcrumb}
  showRails={false}
>
  <!-- ================= KEPALA HALAMAN ================= -->
  <section class="pagehead" data-mark="orange" style="padding-top: clamp(var(--s7), 7vw, var(--s10)); padding-bottom: var(--s4);">
    <div class="pagehead__paper-wash" aria-hidden="true"></div>
    <div class="grid-fx" aria-hidden="true">
      <div class="grid-fx__spot grid-fx__spot--a">
        <div class="grid-fx__pattern"></div>
      </div>
      <div class="grid-fx__spot grid-fx__spot--b">
        <div class="grid-fx__pattern"></div>
      </div>
    </div>
    <div class="container pagehead__inner">
      <div class="breadcrumb">
        <a href="/">Beranda</a><span>/</span><span>Projects</span>
      </div>
      <h1 class="pagehead__title">
        <span class="lineMask"><span>Karya nyata</span></span>
        <span class="lineMask"
          ><span class="thin">dari proses belajar.</span></span
        >
      </h1>
      <div class="pagehead__foot">
        <p class="lead" data-reveal style="--reveal-delay: 360ms">
          Kami mendokumentasikan setiap karya yang dirancang dan dibangun, mulai
          dari bot Telegram sederhana hingga sistem pendaftaran kampus.
          Tujuannya satu: agar kode-kode ini bisa dibedah dan dipelajari
          bersama.
        </p>
        <span class="idx">12 PROJECT TERBUKA</span>
      </div>
    </div>
  </section>

  <!-- ================= KISI ================= -->
  <section class="section" style="padding-top: var(--s4); padding-bottom: var(--s4);">
    <div class="container">
      <div class="filterbar">
        <div class="chips" id="projectChips" data-chips>
          <button class="chip is-active" type="button" disabled>Semua</button>
          <button class="chip" type="button" disabled>Web App</button>
          <button class="chip" type="button" disabled>Mobile</button>
          <button class="chip" type="button" disabled>IoT / Hardware</button>
        </div>
        <select
          class="select"
          aria-label="Filter Waktu"
          style="max-width: 220px"
          disabled
        >
          <option>Semua Waktu</option>
          <option>Tahun 2026</option>
          <option>Tahun 2025</option>
        </select>
      </div>

      <div
        class="bento"
        id="projectGrid"
        style="margin-top: var(--s7)"
        data-stagger="70"
        data-cursor="Lihat cepat"
      >
        {
          projects.map((p) => {
            return <ProjectCard project={p} />;
          })
        }
      </div>

      <div class="pagination" data-pagination>
        <!-- Injected via JS -->
      </div>
    </div>
  </section>

  <template id="all-projects-template">
    {
      projects.map((p: any) => (
        <div
          data-project-item
          data-kategori={p.kategori}
          data-title={(p.nama || p.title || "").toLowerCase()}
          data-date={p.tahun || p.tanggal || ""}
        >
          <ProjectCard project={p} />
        </div>
      ))
    }
  </template>

  <template id="empty-state-template">
    <EmptyState />
  </template>

  <template id="skeleton-projects-template">
    <div class="pcard skeleton-card" style="pointer-events:none;">
      <div class="skeleton skeleton-img"></div>
      <div class="pcard__body" style="padding: 0;">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text long"></div>
        <div class="skeleton skeleton-text medium"></div>
      </div>
    </div>
  </template>

  <script src="../../scripts/filter.ts"></script>


</Layout>
