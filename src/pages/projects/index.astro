---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { UKM_FIXTURE } from "../../lib/content/fixture";
import { fetchSanity } from "../../lib/sanity/client";
import { siteSettingsQuery, allProjectsQuery } from "../../lib/sanity/queries";

let settings = UKM_FIXTURE.settings;
let projects = UKM_FIXTURE.projects;

const [sanitySettings, sanityProjects] = await Promise.all([
  fetchSanity<any>(siteSettingsQuery),
  fetchSanity<any[]>(allProjectsQuery),
]);

if (sanitySettings) {
  settings = { ...settings, ...sanitySettings };
}

if (sanityProjects && sanityProjects.length > 0) {
  projects = sanityProjects;
}
---

<Layout title={`Showcase | ${settings.nama}`}>
  <!-- ================= KEPALA HALAMAN ================= -->
  <section class="pagehead" data-mark="orange">
    <div class="pagehead__grid" aria-hidden="true"></div>
    <div class="container pagehead__inner">
      <div class="breadcrumb">
        <a href="/">Beranda</a><span>/</span><span>Projects</span>
      </div>
      <h1 class="pagehead__title">
        <span class="lineMask"><span>Karya yang lahir</span></span>
        <span class="lineMask"
          ><span class="thin">dari proses belajar.</span></span
        >
      </h1>
      <div class="pagehead__foot">
        <p class="lead" data-reveal style="--reveal-delay: 360ms">
          Kami mendokumentasikan apa yang kami bangun—dari bot Telegram
          sederhana sampai sistem pendaftaran yang dipakai kampus. Bukan untuk
          pamer, tapi untuk dibongkar dan dipelajari.
        </p>
        <span class="idx">12 PROJECT TERBUKA</span>
      </div>
    </div>
  </section>

  <!-- ================= KISI ================= -->
  <section class="section">
    <div class="container">
      <div class="filterbar">
        <div class="chips" id="projectChips" data-chips>
          <button class="chip is-active" type="button" disabled>Semua</button>
          <button class="chip" type="button" disabled>Web App</button>
          <button class="chip" type="button" disabled>Mobile</button>
          <button class="chip" type="button" disabled>IoT / Hardware</button>
        </div>
        <select
          class="select"
          aria-label="Urutkan"
          style="max-width: 220px"
          disabled
        >
          <option>Terbaru</option>
          <option>Terlama</option>
          <option>Nama A–Z</option>
        </select>
      </div>

      <div
        class="bento"
        id="projectGrid"
        style="margin-top: var(--s7)"
        data-stagger="70"
        data-cursor="Lihat cepat"
      >
        {
          projects.map((p, i) => {
            // Pola grid bento
            const size = i % 5 === 0 ? "tall" : i % 5 === 4 ? "wide" : "normal";
            return <ProjectCard project={p} size={size} />;
          })
        }
      </div>

      <div class="pagination" data-pagination>
        <!-- Injected via JS -->
      </div>
    </div>
  </section>

  <template id="all-projects-template">
    {
      projects.map((p: any) => (
        <div
          data-project-item
          data-kategori={p.kategori}
          data-title={(p.nama || p.title).toLowerCase()}
          data-date={p.tahun || p.tanggal || ""}
        >
          <ProjectCard project={p} size="normal" />
        </div>
      ))
    }
  </template>

  <template id="empty-state-template">
    <EmptyState />
  </template>

  <script src="../../scripts/filter.ts"></script>

  <!-- ================= CARA KERJA ================= -->
  <section class="section section--hairline">
    <div class="container">
      <div class="shead">
        <div class="shead__top">
          <span class="label">Cara kami membangun</span>
          <span class="idx">EMPAT TAHAP</span>
        </div>
        <div class="shead__body">
          <h2 data-reveal>Bukan sekadar tugas kuliah</h2>
          <p class="dek" data-reveal>
            Setiap project melewati alur yang sama supaya hasilnya bisa dirawat
            pengurus berikutnya.
          </p>
        </div>
      </div>
      <div class="pillars" data-stagger="80">
        <div class="pillar" data-reveal>
          <span class="pillar__num">01</span>
          <h3 class="pillar__title">Masalah nyata dulu</h3>
          <p class="pillar__text">
            Ide datang dari keluhan yang benar-benar terjadi — pendaftaran
            manual, absensi berantakan, rekap nilai lomba yang lambat.
          </p>
        </div>
        <div class="pillar" data-reveal>
          <span class="pillar__num">02</span>
          <h3 class="pillar__title">Tim kecil, peran jelas</h3>
          <p class="pillar__text">
            Dua sampai empat orang per project, dengan satu penanggung jawab
            teknis dan satu penanggung jawab kebutuhan.
          </p>
        </div>
        <div class="pillar" data-reveal>
          <span class="pillar__num">03</span>
          <h3 class="pillar__title">Stack yang kami kuasai</h3>
          <p class="pillar__text">
            Kami tidak mengejar tren. Kami memakai React, Tailwind, Express,
            atau kadang sekadar Vanilla PHP asalkan sesuai kebutuhan.
          </p>
        </div>
        <div class="pillar" data-reveal>
          <span class="pillar__num">04</span>
          <h3 class="pillar__title">Dokumentasikan semuanya</h3>
          <p class="pillar__text">
            Kode yang bekerja tapi tidak bisa dipelajari orang lain dianggap
            belum selesai. Semua repository utama diberi panduan.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
