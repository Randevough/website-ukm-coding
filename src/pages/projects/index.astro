---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { UKM_FIXTURE } from "../../lib/content/fixture";
import { fetchSanity } from "../../lib/sanity/client";
import { siteSettingsQuery, allProjectsQuery } from "../../lib/sanity/queries";

let settings = UKM_FIXTURE.settings;
let projects = UKM_FIXTURE.projects;

const [sanitySettings, sanityProjects] = await Promise.all([
  fetchSanity<any>(siteSettingsQuery),
  fetchSanity<any[]>(allProjectsQuery),
]);

if (sanitySettings) {
  settings = { ...settings, ...sanitySettings };
}

if (sanityProjects && sanityProjects.length > 0) {
  projects = sanityProjects;
}

const breadcrumb = [
  { name: "Beranda", item: new URL("/", Astro.site || Astro.url.origin).href },
  {
    name: "Projects",
    item: new URL("/projects", Astro.site || Astro.url.origin).href,
  },
];
---

<Layout
  title={`Projects | ${settings.nama}`}
  description="Karya inovatif mahasiswa Cyber University yang berawal dari hobi dan eksperimen teknologi."
  breadcrumb={breadcrumb}
  showRails={false}
>
  <!-- ================= KEPALA HALAMAN ================= -->
  <section class="pagehead" data-mark="orange">
    <div class="pagehead__paper-wash" aria-hidden="true"></div>
    <grid-reveal class="pagehead__grid" aria-hidden="true"></grid-reveal>
    <div class="container pagehead__inner">
      <div class="breadcrumb">
        <a href="/">Beranda</a><span>/</span><span>Projects</span>
      </div>
      <h1 class="pagehead__title">
        <span class="lineMask"><span>Karya nyata</span></span>
        <span class="lineMask"
          ><span class="thin">dari proses belajar.</span></span
        >
      </h1>
      <div class="pagehead__foot">
        <p class="lead" data-reveal style="--reveal-delay: 360ms">
          Kami mendokumentasikan setiap karya yang dirancang dan dibangun, mulai
          dari bot Telegram sederhana hingga sistem pendaftaran kampus.
          Tujuannya satu: agar kode-kode ini bisa dibedah dan dipelajari
          bersama.
        </p>
        <span class="idx">12 PROJECT TERBUKA</span>
      </div>
    </div>
  </section>

  <!-- ================= KISI ================= -->
  <section class="section">
    <div class="container">
      <div class="filterbar">
        <div class="chips" id="projectChips" data-chips>
          <button class="chip is-active" type="button" disabled>Semua</button>
          <button class="chip" type="button" disabled>Web App</button>
          <button class="chip" type="button" disabled>Mobile</button>
          <button class="chip" type="button" disabled>IoT / Hardware</button>
        </div>
        <select
          class="select"
          aria-label="Urutkan"
          style="max-width: 220px"
          disabled
        >
          <option>Terbaru</option>
          <option>Terlama</option>
          <option>Nama A–Z</option>
        </select>
      </div>

      <div
        class="bento"
        id="projectGrid"
        style="margin-top: var(--s7)"
        data-stagger="70"
        data-cursor="Lihat cepat"
      >
        {
          projects.map((p) => {
            return <ProjectCard project={p} />;
          })
        }
      </div>

      <div class="pagination" data-pagination>
        <!-- Injected via JS -->
      </div>
    </div>
  </section>

  <template id="all-projects-template">
    {
      projects.map((p: any) => (
        <div
          data-project-item
          data-kategori={p.kategori}
          data-title={(p.nama || p.title || "").toLowerCase()}
          data-date={p.tahun || p.tanggal || ""}
        >
          <ProjectCard project={p} />
        </div>
      ))
    }
  </template>

  <template id="empty-state-template">
    <EmptyState />
  </template>

  <template id="skeleton-projects-template">
    <div class="pcard skeleton-card" style="pointer-events:none;">
      <div class="skeleton skeleton-img"></div>
      <div class="pcard__body" style="padding: 0;">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text long"></div>
        <div class="skeleton skeleton-text medium"></div>
      </div>
    </div>
  </template>

  <script src="../../scripts/filter.ts"></script>

  <!-- ================= CARA KERJA ================= -->
  <section class="section section--hairline">
    <div class="container">
      <div class="shead">
        <div class="shead__top">
          <span class="label">Cara kami membangun</span>
          <span class="idx">EMPAT TAHAP</span>
        </div>
        <div class="shead__body">
          <h2 data-reveal>Cara Kami Membangun</h2>
          <p class="dek" data-reveal>
            Setiap project yang kami buat selalu melewati standar alur
            pengerjaan agar hasilnya terukur dan mudah dilanjutkan oleh pengurus
            generasi berikutnya.
          </p>
        </div>
      </div>
      <div class="pillars" data-stagger="80">
        <div class="pillar" data-reveal>
          <span class="pillar__num">01</span>
          <h3 class="pillar__title">Berawal dari masalah nyata</h3>
          <p class="pillar__text">
            Setiap ide selalu lahir dari permasalahan di sekitar kita, seperti
            pendaftaran yang masih manual, absensi berantakan, hingga lambatnya
            rekap nilai perlombaan.
          </p>
        </div>
        <div class="pillar" data-reveal>
          <span class="pillar__num">02</span>
          <h3 class="pillar__title">Tim kecil, peran jelas</h3>
          <p class="pillar__text">
            Kami bekerja dalam tim kecil (2-4 orang) per project agar tetap
            fokus. Setiap tim memiliki satu penanggung jawab teknis dan satu
            pengelola kebutuhan.
          </p>
        </div>
        <div class="pillar" data-reveal>
          <span class="pillar__num">03</span>
          <h3 class="pillar__title">Stack yang kami kuasai</h3>
          <p class="pillar__text">
            Kami tidak memaksakan diri mengikuti tren. Kami memilih alat yang
            tepat sasaran, entah itu React, Tailwind, Express, atau bahkan
            Vanilla PHP selama efektif.
          </p>
        </div>
        <div class="pillar" data-reveal>
          <span class="pillar__num">04</span>
          <h3 class="pillar__title">Dokumentasikan semuanya</h3>
          <p class="pillar__text">
            Kode yang berfungsi tapi sulit dipelajari orang lain kami anggap
            belum rampung. Oleh karena itu, setiap repository utama kami
            lengkapi dengan panduan yang jelas.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
