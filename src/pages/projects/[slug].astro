---
import Layout from "../../layouts/Layout.astro";
import Art from "../../components/global/Art.astro";
import Arrow from "../../components/global/Arrow.astro";
import SanityImage from "../../components/sanity/SanityImage.astro";
import PortableTextComponent from "../../components/sanity/PortableTextComponent.astro";
import { UKM_FIXTURE } from "../../lib/content/fixture";
import { fetchSanity } from "../../lib/sanity/client";
import { siteSettingsQuery, allProjectsQuery } from "../../lib/sanity/queries";

export async function getStaticPaths() {
  let projects = UKM_FIXTURE.projects;
  const sanityProjects = await fetchSanity<any[]>(allProjectsQuery);
  if (sanityProjects && sanityProjects.length > 0) {
    projects = sanityProjects;
  }

  projects.sort((a, b) => {
    const da = new Date((a as any).tahun || (a as any).tanggal || 0).getTime();
    const db = new Date((b as any).tahun || (b as any).tanggal || 0).getTime();
    return db - da;
  });

  return projects.map((project: any, index: number) => {
    return {
      params: { slug: project.slug },
      props: {
        project,
        prev: index > 0 ? projects[index - 1] : null,
        next: index < projects.length - 1 ? projects[index + 1] : null,
      },
    };
  });
}

const { project: p, prev, next } = Astro.props as any;
let settings = UKM_FIXTURE.settings;
const sanitySettings = await fetchSanity<any>(siteSettingsQuery);
if (sanitySettings) {
  settings = { ...settings, ...sanitySettings };
}

const title = p.nama || p.title;
const oneLiner = p.ringkasan || p.oneLiner;
const stack = p.techStack || p.stack || [];

const isSanityBlocks = (content: any) =>
  Array.isArray(content) &&
  content.length > 0 &&
  typeof content[0] === "object" &&
  Boolean(content[0]?._type);

const isStringArray = (content: any) =>
  Array.isArray(content) &&
  content.length > 0 &&
  typeof content[0] === "string";
const breadcrumb = [
  { name: "Beranda", item: new URL("/", Astro.site || Astro.url.origin).href },
  {
    name: "Projects",
    item: new URL("/projects", Astro.site || Astro.url.origin).href,
  },
  {
    name: title,
    item: new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href,
  },
];
---

<Layout
  title={`${title} | ${settings.nama}`}
  description={oneLiner}
  breadcrumb={breadcrumb}
  showRails={false}
>
  <section
    class="section"
    style="padding-top: clamp(var(--s5), 4vw, var(--s7)); padding-bottom: var(--s5);"
  >
    <div class="container container--text" id="case">
      <header class="case__head">
        <div class="breadcrumb" style="margin-bottom: var(--s4);">
          <a href="/">Beranda</a><span>/</span><a href="/projects">Projects</a
          ><span>/</span><span>Detail</span>
        </div>
        <div class="case__tagRow">
          <span class="label label--mark">{p.kategori}</span>
          <span class="case__year">{p.tahun}</span>
        </div>
        <div class="case__titleBlock">
          <h1 class="case__title">{title}</h1>
          <p class="case__lead">{oneLiner}</p>
        </div>
        <div class="case__meta">
          <div class="case__metaCol">
            <span>Stack Utama</span><strong class="mono"
              >{stack.length > 0 ? stack.join(" · ") : "—"}</strong
            >
          </div>
          <div class="case__metaCol case__metaCol--action">
            <button
              class="btn btn--sm btn--share"
              data-share
              type="button"
              aria-label="Bagikan project ini"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="btn__icon"
              >
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span class="btn__text">Bagikan</span>
            </button>
          </div>
        </div>
      </header>
      <div class="case__art" style="overflow: hidden; position: relative;">
        {
          p.cover ? (
            <SanityImage
              node={p.cover}
              variantFallback={p.variant}
              glyphFallback={title}
              loading="eager"
            />
          ) : (
            <Art variant={p.variant || "mix"} glyph={title} />
          )
        }
      </div>
      <div class="case__content">
        <div class="case__section">
          <h3 class="label label--mark">Masalah</h3>
          {
            isSanityBlocks(p.masalah) ? (
              <PortableTextComponent value={p.masalah} />
            ) : isStringArray(p.masalah) ? (
              <ul>
                {p.masalah.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>{p.masalah}</p>
            )
          }
        </div>

        <div class="case__section">
          <h3 class="label label--mark">Pendekatan</h3>
          {
            isSanityBlocks(p.pendekatan) ? (
              <PortableTextComponent value={p.pendekatan} />
            ) : isStringArray(p.pendekatan) ? (
              <ul>
                {p.pendekatan.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>{p.pendekatan}</p>
            )
          }
        </div>

        <div class="case__section">
          <h3 class="label label--mark">Hasil</h3>
          {
            isSanityBlocks(p.hasil) ? (
              <PortableTextComponent value={p.hasil} />
            ) : isStringArray(p.hasil) ? (
              <ul>
                {p.hasil.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>{p.hasil}</p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--nav section--hairline">
    <div class="container container--text">
      <div class="pagenav" id="caseNav">
        {
          prev ? (
            <a class="pagenav__prev" href={`/projects/${prev.slug}`}>
              <span class="label">
                <Arrow direction="left" size={13} />
                Sebelumnya
              </span>
              <span class="pagenav__title">{prev.nama || prev.title}</span>
            </a>
          ) : (
            <div />
          )
        }
        {
          next ? (
            <a class="pagenav__next" href={`/projects/${next.slug}`}>
              <span class="label">
                Selanjutnya
                <Arrow direction="right" size={13} />
              </span>
              <span class="pagenav__title">{next.nama || next.title}</span>
            </a>
          ) : (
            <div />
          )
        }
      </div>
    </div>
  </section>

  <section class="section cta graph" data-mark="orange">
    <div class="container cta__inner">
      <div class="stack" data-stagger="80">
        <span class="label label--mark">Kerja sama</span>
        <h2 class="cta__title" data-reveal>
          Punya project yang ingin <em>dibangun bersama?</em>
        </h2>
      </div>
      <div class="cta__actions" data-reveal>
        <a
          class="btn btn--mark btn--lg"
          data-mailto
          href={`mailto:${settings.email}`}>Diskusi project</a
        >
        <a class="btn btn--lg" href="/projects">Lihat project lain</a>
      </div>
    </div>
  </section>
</Layout>
