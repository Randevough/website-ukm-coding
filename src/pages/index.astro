---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import PostCard from "../components/ui/PostCard.astro";
import Art from "../components/global/Art.astro";
import Arrow from "../components/global/Arrow.astro";
import SanityImage from "../components/sanity/SanityImage.astro";
import { UKM_FIXTURE } from "../lib/content/fixture";
import { fetchSanity } from "../lib/sanity/client";
import {
  siteSettingsQuery,
  allProjectsQuery,
  allEditorialsQuery,
  galleryQuery,
} from "../lib/sanity/queries";

let settings = UKM_FIXTURE.settings;
let featuredProjects = UKM_FIXTURE.projects.slice(0, 3);
let latestPosts = UKM_FIXTURE.posts.slice(0, 4);
let galleryItems = [0, 1, 2, 3, 4, 5, 6, 7].map((i) => ({
  _type: "placeholder",
  i,
}));

const [sanitySettings, sanityProjects, sanityPosts, sanityGallery] =
  await Promise.all([
    fetchSanity<any>(siteSettingsQuery),
    fetchSanity<any[]>(allProjectsQuery),
    fetchSanity<any[]>(allEditorialsQuery),
    fetchSanity<any[]>(galleryQuery),
  ]);

if (sanitySettings) {
  settings = {
    ...settings,
    ...sanitySettings,
    mediaPartnerUrl: sanitySettings.mediaPartnerUrl || settings.mediaPartnerUrl,
  };
}

if (sanityProjects && sanityProjects.length > 0) {
  featuredProjects = sanityProjects.filter((p) => p.featured).slice(0, 3);
  if (featuredProjects.length === 0) {
    featuredProjects = sanityProjects.slice(0, 3);
  }
}

if (sanityPosts && sanityPosts.length > 0) {
  latestPosts = sanityPosts.slice(0, 4);
}

if (sanityGallery && sanityGallery.length > 0) {
  galleryItems = sanityGallery.slice(0, 8);
}

const featuredStory = latestPosts[0];
const listStories = latestPosts.slice(1, 4);

const BULAN = [
  "Januari",
  "Februari",
  "Maret",
  "April",
  "Mei",
  "Juni",
  "Juli",
  "Agustus",
  "September",
  "Oktober",
  "November",
  "Desember",
];
function tanggalPendek(iso: string) {
  if (!iso) return "";
  const d = new Date(iso + (iso.includes("T") ? "" : "T00:00:00"));
  if (isNaN(d.getTime())) return iso;
  return (
    d.getDate() + " " + BULAN[d.getMonth()].slice(0, 3) + " " + d.getFullYear()
  );
}
---

<Layout title={`Beranda | ${settings.nama}`}>
  <section class="section hero hero--v2">
    <div class="hero__paper-wash" aria-hidden="true"></div>
    <div class="grid-fx" aria-hidden="true">
      <div class="grid-fx__spot grid-fx__spot--a">
        <div class="grid-fx__pattern"></div>
      </div>
      <div class="grid-fx__spot grid-fx__spot--b">
        <div class="grid-fx__pattern"></div>
      </div>
    </div>
    <div class="container hero__inner">
      <div class="hero__split">
        <div class="hero__left">
          <span class="label label--mark"
            >UNIT KEGIATAN MAHASISWA · CYBER UNIVERSITY</span
          >
          <h1 class="hero__display">
            <span class="lineMask" data-parallax="0.02"
              ><span>Belajar bersama,</span></span
            ><span class="lineMask" data-parallax="0.05"
              ><span class="thin">membangun <em>yang berguna</em></span></span
            >
          </h1>
          <p class="hero__lead" data-reveal="" style="--reveal-delay: 320ms">
            UKM Coding Cyber University adalah ruang kolaborasi mahasiswa dengan
            minat yang sama pada coding dan tech untuk bertukar insight,
            mengembangkan project, serta menjalankan berbagai program bersama.
          </p>
          <div
            class="hero__actions"
            data-reveal=""
            style="--reveal-delay: 420ms"
          >
            <a
              class="btn btn--primary btn--lg"
              href="#kerjasama"
              data-cursor="Jelajahi">Mulai kolaborasi <Arrow /></a
            >
            <a class="btn btn--lg" href="#projects">Lihat project</a>
          </div>
        </div>
        <div
          class="hero__visual"
          data-reveal="fade"
          style="--reveal-delay: 200ms"
          aria-hidden="true"
          data-cursor="Lihat"
        >
          <div class="hero__card hero__card--editorial">
            <span class="hero__cardTag idx">LIFE AT UKM CODING</span>
            <div class="hero__cardImageWrap">
              <img
                src="/hero-image.jpg"
                alt="Mahasiswa UKM Coding Cyber University berkolaborasi membangun project teknologi"
                class="hero__cardImg"
                width="1200"
                height="800"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="hero__cardWord">
              kode <em><Arrow size={20} strokeWidth={2.5} /></em> karya
            </div>
            <div class="hero__cardFoot">
              <span>PROJECT · PELATIHAN · EVENT · KOMPETISI</span><span
                >2026</span
              >
            </div>
          </div>
        </div>
      </div>
      <div class="hero__meta">
        <span>JAKARTA · INDONESIA</span>
        <span>TERBUKA UNTUK KOLABORASI</span>
        <span class="hero__metaMark">DIBANGUN DAN DIJALANKAN BERSAMA</span>
      </div>
    </div>
  </section>

  <section
    class="section section--paper2"
    data-mark="orange"
    id="tentang"
    aria-labelledby="tentang-title"
  >
    <div class="container about2">
      <div class="about2__side">
        <span class="label">TENTANG UKM</span>
        <h2 class="about2__h" id="tentang-title">
          Proses belajar yang <em>dibangun bersama</em>
        </h2>
        <span class="about2__rule"></span>
      </div>
      <div class="about2__flow">
        <p class="about2__lead" data-reveal="">
          Di sini, anggota belajar dari satu sama lain sambil mengerjakan
          project dan menjalankan program bersama.
        </p>
        <div class="about2__blocks">
          <article class="about2__block" data-reveal="">
            <span class="about2__num">01</span>
            <div>
              <h3>Belajar dari satu sama lain</h3>
              <p>
                Kelas internal, sesi latihan, dan diskusi jadi tempat anggota
                bertukar pemahaman. Tidak harus berada di level yang sama untuk
                bisa ikut belajar.
              </p>
            </div>
          </article>
          <article class="about2__block" data-reveal="">
            <span class="about2__num">02</span>
            <div>
              <h3>Mengerjakan project sebagai tim</h3>
              <p>
                Ide dan materi kelas langsung dipraktikkan lewat project
                bersama. Anggota belajar bagi peran, saling review code, dan
                mengawal project sampai siap rilis.
              </p>
            </div>
          </article>
          <article class="about2__block" data-reveal="">
            <span class="about2__num">03</span>
            <div>
              <h3>Menjalankan program bersama</h3>
              <p>
                Menjalankan program kerja UKM Coding mulai dari pelatihan,
                event, hingga kompetisi. Anggota eksekusi acara dari nol
                sekaligus membuka ruang kolaborasi eksternal.
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section section--hairline"
    id="projects"
    aria-labelledby="projects-title"
    style="isolation: isolate; overflow: hidden;"
  >
    <div class="hero__paper-wash" aria-hidden="true"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <div class="shead">
        <div class="shead__top">
          <span class="label label--mark">PROJECT PILIHAN</span>
          <span class="idx">CURATED BY UKM CODING</span>
        </div>
        <div class="shead__body">
          <h2 data-reveal="" id="projects-title">
            Yang dipelajari, <span style="color: var(--blue)"
              >kami kerjakan</span
            >
          </h2>
          <p class="dek" data-reveal="">
            Beberapa project yang dikerjakan anggota UKM Coding sambil belajar
            dan bekerja sebagai tim.
          </p>
        </div>
      </div>

      <div class="grid grid--3" data-stagger="80" id="featuredProjects">
        {
          featuredProjects.map((p, i) => {
            return <ProjectCard project={p} size="normal" index={i} />;
          })
        }
      </div>

      <div class="row" style="margin-top: var(--s7); justify-content: flex-end">
        <a class="tlink" href="/projects">Lihat semua Projects <Arrow /></a>
      </div>
    </div>
  </section>

  <section
    class="section section--paper2"
    data-mark="orange"
    id="updates"
    aria-labelledby="updates-title"
  >
    <div class="container">
      <div class="shead">
        <div class="shead__top">
          <span class="label label--mark">Updates Terbaru</span>
        </div>
        <div class="shead__body">
          <h2 data-reveal="" id="updates-title">
            Yang kami jalankan,<br /><em>kami dokumentasikan</em>
          </h2>
          <p class="dek" data-reveal="">
            Catatan dari program kerja, project, event, dan kolaborasi yang
            telah dijalankan UKM Coding.
          </p>
        </div>
      </div>

      <div class="updates-layout" data-stagger="70" id="latestPosts">
        {
          featuredStory && (
            <div class="updates-layout__featured" data-reveal>
              <PostCard post={featuredStory} />
            </div>
          )
        }
        <div class="updates-layout__list">
          {
            listStories.map((p: any) => {
              const kategori = p.tipe || p.kategori;
              const date = p.tanggalPublikasi || p.tanggal;
              const title = p.judul || p.title;
              return (
                <a
                  class="editorial-row"
                  href={`/updates/${p.slug}`}
                  data-reveal
                >
                  <div class="editorial-row__head">
                    <span class="label label--mark">{kategori}</span>
                  </div>
                  <h3 class="editorial-row__title">{title}</h3>
                  <div class="editorial-row__foot">
                    <time class="editorial-row__date" datetime={date}>
                      {tanggalPendek(date)}
                    </time>
                    <Arrow class="editorial-row__arrow" />
                  </div>
                </a>
              );
            })
          }
          <div
            class="row"
            style="margin-top: var(--s5); justify-content: flex-end"
          >
            <a class="tlink" href="/updates">Lihat semua Updates <Arrow /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section section--hairline"
    id="galeri"
    aria-labelledby="galeri-title"
    style="padding-block: clamp(32px, 4vw, 48px); isolation: isolate; overflow: hidden;"
  >
    <div class="hero__paper-wash" aria-hidden="true"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <div class="shead">
        <div class="shead__top">
          <span class="label label--mark">GALERI KEGIATAN</span>
        </div>
        <div class="shead__body">
          <h2 data-reveal="" id="galeri-title">
            Di balik kegiatan, ada <em>orang-orangnya</em>
          </h2>
          <p class="dek" data-reveal="">
            Cuplikan dari event, sesi belajar, dan keseharian anggota UKM
            Coding.
          </p>
        </div>
      </div>
      <div class="iggrid" data-stagger="60" id="ig">
        {
          galleryItems.map((item: any, i: number) => (
            <div class={`igcard igcard--${i + 1}`} data-reveal>
              <div class="igcard__art">
                {item._type === "placeholder" ? (
                  <Art variant={["blue", "mix", "orange"][i % 3]} />
                ) : (
                  <SanityImage node={item.gambar} />
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section section--paper2 collab"
    data-mark="orange"
    id="kerjasama"
    aria-labelledby="kerjasama-title"
    style="padding-block: clamp(48px, 6vw, 64px);"
  >
    <div class="container collab__container">
      <div class="collab__header">
        <div class="shead__top" style="border-bottom: 0; padding-bottom: 0;">
          <span class="label">KERJA SAMA</span>
        </div>
        <h2 class="collab__title" data-reveal="" id="kerjasama-title">
          Mari mulai dari<br />
          <em>apa yang ingin dicapai</em>
        </h2>
        <p class="collab__intro" data-reveal="" style="--reveal-delay: 100ms">
          Ceritakan tujuan dan target yang ingin dicapai. Dari sana, kita
          rancang format dan pembagian perannya bersama.
        </p>

        <div
          class="collab__actions"
          data-reveal=""
          style="--reveal-delay: 200ms"
        >
          <a
            class="btn btn--primary"
            href={`https://mail.google.com/mail/?view=cm&fs=1&to=${settings.email}&su=Diskusi%20Kolaborasi`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
              ></path>
            </svg>
            Hubungi Kami
          </a>
          {
            settings.mediaPartnerUrl && settings.mediaPartnerUrl !== "#" && (
              <a
                href={settings.mediaPartnerUrl}
                class="btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
                  />
                </svg>
                Media Partner
              </a>
            )
          }
        </div>
      </div>

      <div class="collab__list">
        <div class="collab__list-label" data-reveal="">
          BEBERAPA STARTING POINTS
        </div>
        <ul class="collab__rows" data-stagger="100">
          <li class="collab__row" data-reveal="">
            <span class="collab__row-idx">01</span>
            <div class="collab__row-content">
              <h3 class="collab__row-title">Program &amp; event</h3>
              <p class="collab__row-desc">
                Untuk workshop, seminar, kompetisi, atau program belajar yang
                mempertemukan mahasiswa dengan praktisi dan community.
              </p>
            </div>
          </li>
          <li class="collab__row" data-reveal="">
            <span class="collab__row-idx">02</span>
            <div class="collab__row-content">
              <h3 class="collab__row-title">Media partnership</h3>
              <p class="collab__row-desc">
                Untuk event dan inisiatif yang ingin menjangkau mahasiswa serta
                community yang tepat.
              </p>
            </div>
          </li>
          <li class="collab__row" data-reveal="">
            <span class="collab__row-idx">03</span>
            <div class="collab__row-content">
              <h3 class="collab__row-title">Project kolaboratif</h3>
              <p class="collab__row-desc">
                Untuk kebutuhan nyata yang dapat dikembangkan menjadi project
                dengan scope dan target yang disepakati.
              </p>
            </div>
          </li>
          <li class="collab__row" data-reveal="">
            <span class="collab__row-idx">04</span>
            <div class="collab__row-content">
              <h3 class="collab__row-title">Format lainnya</h3>
              <p class="collab__row-desc">
                Punya bentuk kolaborasi lain? Kita bisa membicarakan format yang
                paling sesuai dari awal.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
