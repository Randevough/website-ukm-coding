---
import Layout from "../../layouts/Layout.astro";
import MagazineCard from "../../components/ui/MagazineCard.astro";
import PostCard from "../../components/ui/PostCard.astro";
import EmptyState from "../../components/ui/EmptyState.astro";
import { UKM_FIXTURE } from "../../lib/content/fixture";
import { fetchSanity } from "../../lib/sanity/client";
import {
  siteSettingsQuery,
  allEditorialsQuery,
} from "../../lib/sanity/queries";

let settings = UKM_FIXTURE.settings;
let posts = UKM_FIXTURE.posts;

const [sanitySettings, sanityPosts] = await Promise.all([
  fetchSanity<any>(siteSettingsQuery),
  fetchSanity<any[]>(allEditorialsQuery),
]);

if (sanitySettings) {
  settings = { ...settings, ...sanitySettings };
}

if (sanityPosts && sanityPosts.length > 0) {
  posts = sanityPosts;
}

const breadcrumb = [
  { name: "Beranda", item: new URL("/", Astro.site || Astro.url.origin).href },
  {
    name: "Updates",
    item: new URL("/kegiatan", Astro.site || Astro.url.origin).href,
  },
];

const featured = posts[0];
const initialPosts = posts.slice(1, 8);

const catCounts = {
  Semua: posts.length,
  Berita: posts.filter((p: any) => (p.tipe || p.kategori) === "Berita").length,
  Kegiatan: posts.filter((p: any) => (p.tipe || p.kategori) === "Kegiatan")
    .length,
  Pengumuman: posts.filter((p: any) => (p.tipe || p.kategori) === "Pengumuman")
    .length,
  Prestasi: posts.filter((p: any) => (p.tipe || p.kategori) === "Prestasi")
    .length,
};
---

<Layout
  title={`Updates | ${settings.nama}`}
  breadcrumb={breadcrumb}
  showRails={false}
>
  <!-- ================= KEPALA HALAMAN ================= -->
  <section class="pagehead" data-mark="green">
    <div class="pagehead__paper-wash" aria-hidden="true"></div>
    <grid-reveal class="pagehead__grid" aria-hidden="true"></grid-reveal>
    <div class="container pagehead__inner">
      <div class="breadcrumb">
        <a href="/">Beranda</a><span>/</span><span>Updates</span>
      </div>
      <h1 class="pagehead__title">
        <span class="lineMask"><span>Arsip kegiatan</span></span>
        <span class="lineMask"
          ><span class="thin">&amp; liputan media.</span></span
        >
      </h1>
      <div
        style="display: flex; flex-direction: column; gap: var(--s4); margin-top: var(--s6); max-width: 60ch;"
      >
        <p class="lead" data-reveal style="--reveal-delay: 360ms">
          Kami mendokumentasikan setiap event dan kolaborasi secara lengkap. Log
          aktivitas ini berfungsi sebagai referensi bagi media, calon partner,
          maupun kepengurusan berikutnya.
        </p>
        <span class="idx" style="color: var(--blue)"
          >14 CATATAN · 5 KATEGORI</span
        >
      </div>
    </div>
  </section>

  <!-- ================= HERO MAJALAH ================= -->
  <section class="section section--tight section--hairline">
    <div class="container">
      <div
        class="shead__top"
        style="margin-bottom: var(--s6); display: flex; align-items: center; justify-content: space-between;"
      >
        <div class="badge-highlight">Sorotan Utama</div>
        <div class="badge-new">
          <span>Paling Baru</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 5v14"></path>
            <path d="m19 12-7 7-7-7"></path>
          </svg>
        </div>
      </div>
      <div class="magazine" id="magazine">
        {featured && <MagazineCard post={featured} />}
      </div>
    </div>
  </section>

  <!-- ================= DAFTAR ================= -->
  <section class="section" style="padding-top: var(--s4)">
    <div class="container">
      <div class="filterbar">
        <div class="chips" id="postChips" data-chips>
          <button
            class="chip is-active"
            type="button"
            data-category="Semua"
            disabled
            >Semua <span class="chip__count">{catCounts.Semua}</span></button
          >
          <button class="chip" type="button" data-category="Berita" disabled
            >Berita <span class="chip__count">{catCounts.Berita}</span></button
          >
          <button class="chip" type="button" data-category="Kegiatan" disabled
            >Kegiatan <span class="chip__count">{catCounts.Kegiatan}</span
            ></button
          >
          <button class="chip" type="button" data-category="Pengumuman" disabled
            >Pengumuman <span class="chip__count">{catCounts.Pengumuman}</span
            ></button
          >
          <button class="chip" type="button" data-category="Prestasi" disabled
            >Prestasi <span class="chip__count">{catCounts.Prestasi}</span
            ></button
          >
        </div>
        <input
          class="search"
          type="search"
          placeholder="Cari judul kegiatan…"
          aria-label="Cari berita"
          disabled
        />
      </div>

      <div
        class="updates-grid"
        id="postGrid"
        data-stagger="80"
        style="margin-top: var(--s6)"
      >
        {initialPosts.map((p: any) => <PostCard post={p} />)}
      </div>

      <div class="pagination" data-pagination>
        <!-- Injected via JS -->
      </div>
    </div>
  </section>

  <template id="all-posts-template">
    {
      posts.map((p: any) => (
        <div
          data-post-item
          data-kategori={p.tipe || p.kategori}
          data-title={(p.judul || p.title || "").toLowerCase()}
        >
          <PostCard post={p} />
        </div>
      ))
    }
  </template>

  <template id="empty-state-template">
    <EmptyState />
  </template>

  <template id="skeleton-posts-template">
    <div class="ncard skeleton-card">
      <div class="skeleton skeleton-img"></div>
      <div class="skeleton skeleton-label"></div>
      <div class="skeleton skeleton-title"></div>
      <div class="skeleton skeleton-text short"></div>
    </div>
  </template>

  <script src="../../scripts/filter.ts"></script>
</Layout>
