---
import type { Project } from "@/types/content";
import Art from "../global/Art.astro";
import Arrow from "../global/Arrow.astro";
import SanityImage from "../sanity/SanityImage.astro";

export interface Props {
  project: Project | any;
  size?: "normal" | "tall" | "wide";
  index?: number;
}
const { project: p, size = "normal", index } = Astro.props;

const mod =
  size === "tall" ? " pcard--tall" : size === "wide" ? " pcard--wide" : "";
const labelPrefix =
  index != null ? String(index + 1).padStart(2, "0") + " · " : "";

const title = p.nama || p.title;
const oneLiner = p.ringkasan || p.oneLiner;
const stack = p.techStack || p.stack || [];
---

<a
  class={`pcard${mod}`}
  href={`/projects/${p.slug?.current || p.slug}`}
  data-tilt
  data-reveal
  tabindex="0"
  role="button"
  aria-label={`Lihat cepat ${title}`}
>
  <div class="pcard__art">
    {
      p.cover ? (
        <SanityImage
          node={p.cover}
          variantFallback={p.variant}
          glyphFallback={title}
        />
      ) : (
        <Art variant={p.variant || "mix"} glyph={title} />
      )
    }
  </div>
  <div class="pcard__top">
    <span class="label">{labelPrefix}{p.kategori}</span>
    <span class="idx">{p.tahun}</span>
  </div>
  <div class="pcard__body">
    <h3 class="pcard__title">{title}</h3>
    <p class="pcard__one">{oneLiner}</p>
  </div>
  <div class="pcard__foot">
    <span class="mono"
      >{stack.length > 0 ? stack.slice(0, 3).join(" / ") : "TBA"}</span
    >
    <Arrow size={14} />
  </div>
</a>
