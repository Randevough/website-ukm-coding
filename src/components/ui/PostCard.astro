---
import type { Post } from "@/types/content";
import Art from "../global/Art.astro";
import Arrow from "../global/Arrow.astro";
import SanityImage from "../sanity/SanityImage.astro";

export interface Props {
  post: Post | any;
}
const { post: p } = Astro.props;

const BULAN = [
  "Januari",
  "Februari",
  "Maret",
  "April",
  "Mei",
  "Juni",
  "Juli",
  "Agustus",
  "September",
  "Oktober",
  "November",
  "Desember",
];
function tanggalPendek(iso: string) {
  if (!iso) return "";
  const d = new Date(iso + (iso.includes("T") ? "" : "T00:00:00"));
  if (isNaN(d.getTime())) return iso;
  return (
    d.getDate() + " " + BULAN[d.getMonth()].slice(0, 3) + " " + d.getFullYear()
  );
}

const title = p.judul || p.title;
const kategori = p.tipe || p.kategori;
const date = p.tanggalPublikasi || p.tanggal;
const excerpt = p.ringkasan || p.excerpt;
---

<a
  class="ncard"
  href={`/updates/${p.slug?.current || p.slug}`}
  data-astro-prefetch="viewport"
  data-reveal
>
  <div class="ncard__art">
    {
      p.cover ? (
        <SanityImage
          node={p.cover}
          variantFallback={p.variant}
          glyphFallback={kategori}
        />
      ) : (
        <Art variant={p.variant || "neutral"} glyph={kategori} />
      )
    }
  </div>
  <span class="label label--mark">{kategori}</span>
  <h3 class="ncard__title">{title}</h3>
  {excerpt && <p class="ncard__excerpt">{excerpt}</p>}
  <div class="ncard__meta">
    <time class="ncard__date" datetime={date}>{tanggalPendek(date)}</time>
    <span class="ncard__arrow" aria-hidden="true">
      <Arrow direction="right" size={13} />
    </span>
  </div>
</a>
