---
import type { Post } from "@/types/content";
import { formatShortDate } from "@/lib/content/formatters";
import Art from "../global/Art.astro";
import SanityImage from "../sanity/SanityImage.astro";

export interface Props {
  post: Post | any;
}
const { post: p } = Astro.props;

const title = p.judul || p.title;
const kategori = p.tipe || p.kategori;
const date = p.tanggalPublikasi || p.tanggal;
const excerpt = p.ringkasan || p.excerpt;
const baca = p.baca || 3;
---

<a class="mcard" href={`/updates/${p.slug}`} data-reveal>
  <div class="mcard__bg">
    {
      p.cover ? (
        <SanityImage node={p.cover} variantFallback={p.variant} />
      ) : (
        <Art variant={p.variant || "mix"} />
      )
    }
  </div>
  <div class="mcard__overlay">
    <span
      class="label"
      style="color: rgba(255,255,255,0.8); border-color: rgba(255,255,255,0.3)"
      >{kategori}</span
    >
    <h2 class="mcard__title">{title}</h2>
    <p class="mcard__excerpt">{excerpt}</p>
    <div class="mcard__meta">
      <span>{formatShortDate(date)}</span>
      <span>{baca} menit baca</span>
    </div>
  </div>
</a>
