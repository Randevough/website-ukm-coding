---
import type { Post } from "@/types/content";
import Art from "../global/Art.astro";
import SanityImage from "../sanity/SanityImage.astro";

export interface Props {
  post: any;
}
const { post: p } = Astro.props;

const BULAN = [
  "Januari",
  "Februari",
  "Maret",
  "April",
  "Mei",
  "Juni",
  "Juli",
  "Agustus",
  "September",
  "Oktober",
  "November",
  "Desember",
];
function tanggalPendek(iso: string) {
  if (!iso) return "";
  const d = new Date(iso + (iso.includes("T") ? "" : "T00:00:00"));
  if (isNaN(d.getTime())) return iso;
  return (
    d.getDate() + " " + BULAN[d.getMonth()].slice(0, 3) + " " + d.getFullYear()
  );
}

const title = p.judul || p.title;
const kategori = p.tipe || p.kategori;
const date = p.tanggalPublikasi || p.tanggal;
const excerpt = p.ringkasan || p.excerpt;
const baca = p.baca || 3;
---

<a class="mcard" href={`/kegiatan/${p.slug}`} data-reveal>
  <div class="mcard__art">
    {
      p.cover ? (
        <SanityImage node={p.cover} variantFallback={p.variant} />
      ) : (
        <Art variant={p.variant || "mix"} />
      )
    }
  </div>
  <div class="mcard__content">
    <span class="label">{kategori}</span>
    <h2 class="mcard__title">{title}</h2>
    <p class="mcard__excerpt">{excerpt}</p>
    <div class="mcard__meta">
      <span>{tanggalPendek(date)}</span>
      <span>{baca} menit baca</span>
    </div>
  </div>
</a>
