---
import {
  generateOrganizationSchema,
  generateArticleSchema,
  generateBreadcrumbSchema,
  generateEventSchema,
  type BreadcrumbItem,
} from "../../lib/seo/schema";
import { buildMetaTags, DEFAULT_SITE_NAME } from "../../lib/seo/meta";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: "website" | "article";
  articleData?: {
    headline: string;
    datePublished: string;
    authorName: string;
  };
  eventData?: {
    name: string;
    startDate: string;
    endDate?: string;
    location?: string;
  };
  breadcrumb?: BreadcrumbItem[];
}

const {
  title,
  description,
  image,
  canonical,
  noindex = false,
  type = "website",
  articleData,
  eventData,
  breadcrumb,
} = Astro.props;

const siteName = DEFAULT_SITE_NAME;
const siteUrl = Astro.site ? Astro.site.toString() : Astro.url.origin;

const meta = buildMetaTags({
  title,
  description,
  image,
  canonical,
  noindex,
  pathname: Astro.url.pathname,
  site: Astro.site,
  origin: Astro.url.origin,
});

const orgSchema = generateOrganizationSchema({
  siteName,
  url: siteUrl,
  logo: meta.ogImage,
});

const articleSchema = articleData
  ? generateArticleSchema({
      headline: articleData.headline,
      datePublished: articleData.datePublished,
      authorName: articleData.authorName,
      siteName,
      logo: meta.ogImage,
    })
  : null;

const breadcrumbSchema =
  breadcrumb && breadcrumb.length > 0
    ? generateBreadcrumbSchema(breadcrumb)
    : null;

const eventSchema = eventData
  ? generateEventSchema({
      name: eventData.name,
      startDate: eventData.startDate,
      endDate: eventData.endDate,
      location: eventData.location,
      siteName,
      siteUrl,
    })
  : null;

function safeJsonLd(obj: any): string {
  return JSON.stringify(obj).replace(/</g, "\\u003c");
}
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonicalUrl} />
<meta name="google-site-verification" content="282ef821970df8c3" />

{meta.noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={meta.canonicalUrl} />
<meta property="og:image" content={meta.ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.ogImage} />

<script is:inline type="application/ld+json" set:html={safeJsonLd(orgSchema)} />

{
  articleSchema && (
    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonLd(articleSchema)}
    />
  )
}

{
  breadcrumbSchema && (
    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  )
}

{
  eventSchema && (
    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonLd(eventSchema)}
    />
  )
}
