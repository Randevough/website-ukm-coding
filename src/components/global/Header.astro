---
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const isKegiatan = currentPath.startsWith("/updates");
const isProjects = currentPath.startsWith("/projects");
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <img
        src="/Logo UKM Coding Transparent.webp"
        alt="Logo UKM Coding"
        class="site-header__logo"
        width="38"
        height="38"
        loading="eager"
        fetchpriority="high"
      />
      <span class="site-header__name"
        >UKM Coding<small>Cyber University</small></span
      >
    </a>
    <nav aria-label="Navigasi utama" class="nav hide-sm">
      <a
        class={`nav__link ${isHome ? "is-active" : ""}`}
        href="/"
        aria-current={isHome ? "page" : undefined}>Beranda</a
      >
      <a
        class={`nav__link ${isKegiatan ? "is-active" : ""}`}
        href="/updates"
        aria-current={isKegiatan ? "page" : undefined}>Updates</a
      >
      <a
        class={`nav__link ${isProjects ? "is-active" : ""}`}
        href="/projects"
        aria-current={isProjects ? "page" : undefined}>Projects</a
      >
    </nav>
    <div class="site-header__actions">
      <a class="btn hide-sm" href="/#kerjasama">Kerja sama</a>
      <button
        aria-expanded="false"
        aria-label="Buka menu"
        class="burger"
        id="burger"
        type="button"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
<script>
  function onScroll() {
    const header = document.querySelector(".site-header");
    if (!header) return;
    header.classList.toggle("is-stuck", window.scrollY > 8);
  }

  if (!(window as any).__headerScrollBound) {
    (window as any).__headerScrollBound = true;
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  document.addEventListener("astro:page-load", onScroll);
</script>
