---
import { UKM_FIXTURE } from "@/lib/content/fixture";
import { fetchSanity } from "@/lib/sanity/client";
import { allProjectsQuery } from "@/lib/sanity/queries";

let rawProjects: any[] = UKM_FIXTURE.projects;
const sanityProjects = await fetchSanity<any[]>(allProjectsQuery);
if (sanityProjects && sanityProjects.length > 0) {
  rawProjects = sanityProjects;
}

const projects = rawProjects.map((p) => ({
  slug: typeof p.slug === "string" ? p.slug : p.slug?.current || "",
  title: p.nama || p.title || "",
  kategori: p.kategori || "",
  tahun: p.tahun || "",
  oneLiner: p.ringkasan || p.oneLiner || "",
  stack: (p.techStack || p.stack || []).slice(0, 3).join(" / "),
  variant: p.variant || "mix",
}));
---

<div aria-hidden="true" class="modal" id="projectModal">
  <div class="modal__backdrop" data-modal-close=""></div>
  <div
    aria-label="Detail project"
    aria-modal="true"
    class="modal__panel"
    role="dialog"
  >
    <div class="modal__top">
      <span class="label">Lihat Cepat</span>
      <button
        aria-label="Tutup modal"
        class="modal__close"
        data-modal-close=""
        type="button"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="modal__content" id="modalContent"></div>
    <div class="modal__foot">
      <a class="btn btn--primary btn--block" id="modalLink" href="/projects"
        >Lihat Studi Kasus</a
      >
    </div>
  </div>
</div>

<script is:inline define:vars={{ projects }}>
  const VAR_MAP = { blue: "1", mix: "2", orange: "3", neutral: "4" };

  function escapeHtml(str) {
    return String(str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function glyphOf(text) {
    return String(text || "?")
      .replace(/[^A-Za-z0-9 ]/g, "")
      .split(" ")
      .filter(Boolean)
      .slice(0, 2)
      .map((w) => w[0].toUpperCase())
      .join("");
  }

  function getArtHtml(variant, glyph) {
    const v = VAR_MAP[variant] || "2";
    const g = glyph ? `<div class="art__glyph">${escapeHtml(glyph)}</div>` : "";
    return `<div class="art" data-v="${v}" aria-hidden="true">
      <div class="art__wash"></div><div class="art__mesh"></div><div class="art__ring"></div>${g}
    </div>`;
  }

  let isOpen = false;
  let lastTrigger = null;

  function handleTabKey(e) {
    const modal = document.querySelector("#projectModal");
    if (!isOpen || !modal) return;
    if (e.key === "Tab") {
      const focusableElements =
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
      const focusables = Array.from(
        modal.querySelectorAll(focusableElements),
      ).filter((el) => el.tabIndex >= 0);
      if (focusables.length === 0) return;
      const firstFocusableElement = focusables[0];
      const lastFocusableElement = focusables[focusables.length - 1];

      if (e.shiftKey) {
        if (
          document.activeElement === firstFocusableElement ||
          document.activeElement === modal
        ) {
          lastFocusableElement.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === lastFocusableElement) {
          firstFocusableElement.focus();
          e.preventDefault();
        }
      }
    }
  }

  function openModal(slug) {
    const modal = document.querySelector("#projectModal");
    if (!modal) return;
    const content = document.querySelector("#modalContent");
    const link = document.querySelector("#modalLink");
    const p = projects.find((x) => x.slug === slug);
    if (!p) return;

    if (content) {
      content.innerHTML =
        '<div class="modal__art">' +
        getArtHtml(p.variant, glyphOf(p.title)) +
        "</div>" +
        '<h3 class="modal__title">' +
        escapeHtml(p.title) +
        "</h3>" +
        '<div class="modal__meta"><span>' +
        escapeHtml(p.kategori) +
        "</span><span>" +
        escapeHtml(p.tahun) +
        "</span></div>" +
        '<p class="modal__desc">' +
        escapeHtml(p.oneLiner) +
        "</p>" +
        '<div class="modal__tech"><span class="label">Teknologi Utama</span><span class="mono">' +
        escapeHtml(p.stack) +
        "</span></div>";
    }
    if (link) {
      link.setAttribute("href", `/projects/${slug}`);
    }

    isOpen = true;
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("is-locked");
    const main = document.querySelector("main");
    if (main) main.inert = true;
    modal.setAttribute("tabindex", "-1");
    modal.focus({ preventScroll: true });
  }

  function closeModal() {
    const modal = document.querySelector("#projectModal");
    if (!modal || !isOpen) return;
    isOpen = false;
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("is-locked");
    const main = document.querySelector("main");
    if (main) main.inert = false;
    if (lastTrigger) {
      lastTrigger.focus({ preventScroll: true });
      lastTrigger = null;
    }
  }

  if (!window.__modalGlobalListenersBound) {
    window.__modalGlobalListenersBound = true;

    document.addEventListener("click", (e) => {
      if (e.target.closest("[data-modal-close]")) {
        closeModal();
        return;
      }
      const target = e.target.closest(".pcard");
      if (!target) return;
      const slug = target.getAttribute("data-project");
      if (slug) {
        e.preventDefault();
        lastTrigger = target;
        openModal(slug);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeModal();
        return;
      }
      if (e.key === "Tab" && isOpen) {
        handleTabKey(e);
        return;
      }
      if (e.key === "Enter" || e.key === " ") {
        const target =
          e.target && e.target.closest ? e.target.closest(".pcard") : null;
        if (target && !isOpen) {
          const slug = target.getAttribute("data-project");
          if (slug) {
            e.preventDefault();
            lastTrigger = target;
            openModal(slug);
          }
        }
      }
    });
  }
</script>
