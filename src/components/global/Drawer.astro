---
import { UKM_FIXTURE } from "@/lib/content/fixture";
import Arrow from "./Arrow.astro";
const { settings } = UKM_FIXTURE;
---

<div aria-hidden="true" class="drawer" id="drawer">
  <div class="drawer__backdrop" data-drawer-close=""></div>
  <div aria-label="Menu" class="drawer__panel" role="dialog" aria-modal="true">
    <div class="drawer__top">
      <span class="label">Menu</span>
      <button
        aria-label="Tutup menu"
        class="drawer__close"
        data-drawer-close=""
        type="button"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="drawer__nav">
      <a class="drawer__link" data-drawer-close="" href="/"
        >Beranda <span>01</span></a
      >
      <a class="drawer__link" data-drawer-close="" href="/updates"
        >Updates <span>02</span></a
      >
      <a class="drawer__link" data-drawer-close="" href="/projects"
        >Projects <span>03</span></a
      >
    </nav>
    <div class="drawer__foot">
      <span class="label">Kontak</span>
      <a class="tlink" data-mailto="" href={`mailto:${settings.email}`}
        ><span>{settings.email}</span></a
      >
      <a
        class="btn btn--primary btn--block"
        data-drawer-close=""
        href="/#kerjasama">Ajukan kerja sama <Arrow /></a
      >
    </div>
  </div>
</div>
<script>
  let isOpen = false;

  function handleTabKey(e: KeyboardEvent) {
    const drawer = document.querySelector("#drawer") as HTMLElement | null;
    if (!isOpen || !drawer) return;
    if (e.key === "Tab") {
      const focusableElements =
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
      const focusables = Array.from(
        drawer.querySelectorAll<HTMLElement>(focusableElements),
      ).filter((el) => el.tabIndex >= 0);
      if (focusables.length === 0) return;
      const firstFocusableElement = focusables[0];
      const lastFocusableElement = focusables[focusables.length - 1];

      if (e.shiftKey) {
        if (
          document.activeElement === firstFocusableElement ||
          document.activeElement === drawer
        ) {
          lastFocusableElement.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === lastFocusableElement) {
          firstFocusableElement.focus();
          e.preventDefault();
        }
      }
    }
  }

  function openDrawer() {
    const drawer = document.querySelector("#drawer") as HTMLElement | null;
    const burger = document.querySelector("#burger") as HTMLElement | null;
    if (!drawer || !burger) return;
    isOpen = true;
    drawer.classList.add("is-open");
    drawer.setAttribute("aria-hidden", "false");
    burger.setAttribute("aria-expanded", "true");
    document.body.classList.add("is-locked");
    drawer.setAttribute("tabindex", "-1");
    const main = document.querySelector("main");
    if (main) main.inert = true;
    drawer.focus({ preventScroll: true });
  }

  function closeDrawer() {
    const drawer = document.querySelector("#drawer") as HTMLElement | null;
    const burger = document.querySelector("#burger") as HTMLElement | null;
    if (!drawer || !isOpen) return;
    isOpen = false;
    drawer.classList.remove("is-open");
    drawer.setAttribute("aria-hidden", "true");
    if (burger) {
      burger.setAttribute("aria-expanded", "false");
      burger.focus({ preventScroll: true });
    }
    document.body.classList.remove("is-locked");
    const main = document.querySelector("main");
    if (main) main.inert = false;
  }

  if (!(window as any).__drawerGlobalListenersBound) {
    (window as any).__drawerGlobalListenersBound = true;

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.closest("#burger")) {
        isOpen ? closeDrawer() : openDrawer();
        return;
      }

      if (target.closest("[data-drawer-close]")) {
        closeDrawer();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeDrawer();
        return;
      }
      if (e.key === "Tab" && isOpen) {
        handleTabKey(e);
      }
    });
  }
</script>
