---
import { UKM_FIXTURE } from "@/lib/content/fixture";
import { fetchSanity } from "@/lib/sanity/client";
import { siteSettingsQuery, partnersQuery } from "@/lib/sanity/queries";
import SanityImage from "@/components/sanity/SanityImage.astro";

let settings: any = UKM_FIXTURE.settings;
let partners: any = UKM_FIXTURE.partners;

const [sanitySettings, sanityPartners] = await Promise.all([
  fetchSanity<any>(siteSettingsQuery),
  fetchSanity<any[]>(partnersQuery),
]);

if (sanitySettings) {
  settings = { ...settings, ...sanitySettings };
}

if (sanityPartners && sanityPartners.length > 0) {
  partners = sanityPartners;
}

function glyphOf(name: string): string {
  if (!name) return "";
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0][0].toUpperCase();
  return (parts[0][0] + parts[1][0]).toUpperCase();
}
---

<footer class="site-footer">
  <section class="partners">
    <div class="container">
      <div class="partners__head">
        <div class="stack" style="gap: 10px">
          <span class="label" style="color: rgba(246, 245, 242, 0.45)">
            Media partner &amp; kolaborator
          </span>
          <h3 style="color: var(--paper)">
            Bertumbuh bersama para kolaborator.
          </h3>
        </div>
        <a class="btn btn--onink" href="/#kerjasama">Jadi partner berikutnya</a>
      </div>
      <div class="partners__grid" id="partnerGrid">
        {
          partners.map((p: any) => (
            <a
              class="plogo"
              href={p.url && p.url !== "#" ? p.url : "/#kerjasama"}
              target={p.url && p.url.startsWith("http") ? "_blank" : undefined}
              rel={
                p.url && p.url.startsWith("http")
                  ? "noopener noreferrer"
                  : undefined
              }
            >
              <span class="plogo__slot">
                {p.logo && p.izinTampilLogo ? (
                  <SanityImage node={p.logo} />
                ) : (
                  <span>{glyphOf(p.nama)}</span>
                )}
              </span>
              <span class="plogo__name">{p.nama}</span>
              <span class="plogo__tier">
                {p.tier || p.tipe || "KOLABORATOR"}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container site-footer__main">
    <div class="site-footer__brand">
      <img
        src="/Logo UKM Coding.png"
        alt="Logo UKM Coding"
        style="height: 38px; width: auto; object-fit: contain; flex: none;"
      />
      <strong style="color: var(--paper)">
        {settings.nama || "UKM Coding Cyber University"}
      </strong>
      <p class="dek" style="color: rgba(246, 245, 242, 0.6)">
        {
          settings.tagline ||
            settings.deskripsiSingkat ||
            "Unit kegiatan mahasiswa bidang teknologi di Cyber University"
        }
      </p>
    </div>

    <div class="fcol">
      <h4>Halaman</h4>
      <a href="/">Beranda</a>
      <a href="/kegiatan">Updates</a>
      <a href="/projects">Projects</a>
    </div>

    <div class="fcol">
      <h4>Kontak</h4>
      <a data-mailto="" href={`mailto:${settings.email}`}>
        <span>{settings.email}</span>
      </a>
      <a
        href={settings.instagramUrl ||
          "https://www.instagram.com/coding.cyberuniversity/"}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{settings.instagram || "@coding.cyberuniversity"}</span>
      </a>
      <a
        href={settings.githubUrl ||
          `https://${settings.github || "github.com/ukmcoding"}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{settings.github || "github.com/ukmcoding"}</span>
      </a>
    </div>

    <div class="fcol">
      <h4>Terhubung</h4>
      <a
        href={settings.instagramUrl ||
          "https://www.instagram.com/coding.cyberuniversity/"}
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
      <a
        href={settings.linkedinUrl ||
          "https://id.linkedin.com/in/ukm-coding-cyber-university-541459379"}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a
        href={settings.githubUrl || "https://github.com/RandDevs"}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <span>© 2026 UKM Coding Cyber University</span>
    <span>Belajar · Membangun · Berbagi</span>
  </div>
</footer>
