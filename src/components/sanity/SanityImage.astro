---
import { urlFor } from "../../lib/sanity/urlFor";
import Art from "../global/Art.astro";

interface Props {
  node: any;
  width?: number;
  variantFallback?: string;
  glyphFallback?: string;
  className?: string;
  loading?: "lazy" | "eager";
  objectFit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  style?: string;
  sizes?: string;
}

const {
  node,
  width = 800,
  variantFallback = "neutral",
  glyphFallback,
  className,
  loading = "lazy",
  objectFit = "cover",
  style: customStyle,
  sizes,
} = Astro.props;

const ref = node?.asset?._ref || node?.asset?._id || "";
const dimMatch = typeof ref === "string" ? ref.match(/-(\d+)x(\d+)-/) : null;
const naturalW = dimMatch ? parseInt(dimMatch[1], 10) : undefined;
const naturalH = dimMatch ? parseInt(dimMatch[2], 10) : undefined;
const computedHeight =
  naturalW && naturalH && width
    ? Math.round((naturalH / naturalW) * width)
    : undefined;

const src = node
  ? urlFor(node)?.width(width).auto("format").quality(85).url()
  : null;
let srcset: string | undefined = undefined;
if (node && src) {
  if (width <= 640) {
    const w15 = Math.round(width * 1.35);
    const targetWidth2x = naturalW ? Math.min(width * 2, naturalW) : width * 2;
    const src15 = urlFor(node)?.width(w15).auto("format").quality(82).url();
    const src2 =
      targetWidth2x > width
        ? urlFor(node)?.width(targetWidth2x).auto("format").quality(80).url()
        : null;
    if (src15 && src2) {
      srcset = `${src} ${width}w, ${src15} ${w15}w, ${src2} ${targetWidth2x}w`;
    } else if (src2) {
      srcset = `${src} 1x, ${src2} 2x`;
    }
  } else {
    const targetWidth2x = naturalW ? Math.min(width * 2, naturalW) : width * 2;
    const src2 =
      targetWidth2x > width
        ? urlFor(node)?.width(targetWidth2x).auto("format").quality(80).url()
        : null;
    if (src2) {
      srcset = `${src} 1x, ${src2} 2x`;
    }
  }
}

const alt = node?.alt || "";
const inlineStyle =
  customStyle !== undefined
    ? customStyle
    : `width: 100%; height: 100%; object-fit: ${objectFit};`;
const computedSizes =
  sizes || (width <= 640 ? `(max-width: 640px) 340px, ${width}px` : undefined);
---

{
  src ? (
    <img
      src={src}
      srcset={srcset}
      sizes={computedSizes}
      alt={alt}
      class={className}
      width={width}
      height={computedHeight}
      style={inlineStyle}
      loading={loading}
      decoding="async"
    />
  ) : (
    <Art variant={variantFallback} glyph={glyphFallback} />
  )
}
