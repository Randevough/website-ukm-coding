---
import { urlFor } from "../../lib/sanity/urlFor";
import Art from "../global/Art.astro";

interface Props {
  node: any;
  variantFallback?: string;
  glyphFallback?: string;
  className?: string;
  loading?: "lazy" | "eager";
  objectFit?: "cover" | "contain" | "fill" | "none" | "scale-down";
}

const {
  node,
  variantFallback = "neutral",
  glyphFallback,
  className,
  loading = "lazy",
  objectFit = "cover",
} = Astro.props;
const src = node ? urlFor(node)?.width(1200).auto("format").url() : null;
const alt = node?.alt || "";
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      class={className}
      style={`width: 100%; height: 100%; object-fit: ${objectFit};`}
      loading={loading}
      decoding="async"
    />
  ) : (
    <Art variant={variantFallback} glyph={glyphFallback} />
  )
}
